# Required by the default OpenAI annotation provider.
OPENAI_API_KEY=

# Optional: required only when models.annotator_provider is set to gemini.
GEMINI_API_KEY=

# Skip Hugging Face Hub network checks for already-downloaded models; without
# this, loading the cached visual encoder can stall for minutes on throttled
# HF metadata requests. Comment this out when downloading a NEW model
# (e.g. switching visual_encoder or whisper size), then re-enable.
HF_HUB_OFFLINE=1

# Comma-separated frontend origins allowed to call the local API.
SCENE_RECALL_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
