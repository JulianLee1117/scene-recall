# Required by default for film annotation and Music Sketch audio/drafts.
OPENAI_API_KEY=

# Required only when an annotation or Music Sketch provider is set to Gemini.
GEMINI_API_KEY=

# Evidence v2 (pipeline/evidence): GEMINI_API_KEY above runs the understanding
# pass; an OpenSubtitles API consumer key plus account adds synced English
# subtitles for films without usable ones (20 downloads/day on a free account).
OPENSUBTITLES_API_KEY=
OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=

# Skip Hugging Face Hub network checks for already-downloaded models; without
# this, loading the cached visual encoder can stall for minutes on throttled
# HF metadata requests. Comment this out when downloading a NEW model
# (e.g. switching visual_encoder or whisper size), then re-enable.
HF_HUB_OFFLINE=1

# Comma-separated frontend origins allowed to call the local API.
SCENE_RECALL_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional managed film downloads (qBittorrent 5.x, on this computer).
# Leave URL blank to keep downloading disabled. Enable its authenticated Web UI.
QBITTORRENT_URL=
QBITTORRENT_USERNAME=
QBITTORRENT_PASSWORD=

# Optional release search via configured Prowlarr indexers.
PROWLARR_URL=
PROWLARR_API_KEY=

# Optional Transitions Lab Runway generation. Never put this in web/.env.local.
# Generation requires an explicit reviewed request; merely adding a key makes no calls.
RUNWAYML_API_SECRET=
